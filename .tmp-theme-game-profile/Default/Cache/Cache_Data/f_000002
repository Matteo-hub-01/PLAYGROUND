/* Palette commune Playground */
:root{
  color-scheme:dark;
  --pg-bg:#080c18;--pg-bg-glow:#1b2d4f;--pg-surface:#121a2c;--pg-surface-2:#1b2740;
  --pg-border:#3a4968;--pg-text:#f8f9ff;--pg-muted:#aebad2;--pg-accent:#79f2c0;
  --pg-accent-ink:#06261b;--pg-gold:#ffd166;--pg-blue:#78a9ff;--pg-danger:#ff7187;
  --bg:var(--pg-bg);--background:var(--pg-bg);--paper:var(--pg-bg);--white:var(--pg-surface);
  --panel:var(--pg-surface);--panel2:var(--pg-surface-2);--panel-2:var(--pg-surface-2);
  --surface:var(--pg-surface);--surface-strong:var(--pg-surface-2);--line:var(--pg-border);
  --border:var(--pg-border);--ink:var(--pg-text);--text:var(--pg-text);--muted:var(--pg-muted);
  --yellow:var(--pg-gold);--gold:var(--pg-gold);--orange:var(--pg-gold);--mint:var(--pg-accent);
  --blue:var(--pg-blue);--pink:var(--pg-danger);--coral:var(--pg-danger);--focus:var(--pg-gold);
}
body:not([data-pg-appearance="light"]){
  color:var(--pg-text);
  background:radial-gradient(circle at 12% 0,var(--pg-bg-glow),transparent 34rem),
    radial-gradient(circle at 92% 100%,#123a33,transparent 30rem),var(--pg-bg);
}
body[data-pg-appearance="light"]{
  --paper:#eef2f7;--white:#fff;--yellow:#c58c00;--gold:#c58c00;--orange:#c97912;
  --pg-accent:#168b68;--pg-gold:#c58c00;--pg-muted:#586176;
}
a,button,select,input,textarea{accent-color:var(--pg-accent)}
button:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible,a:focus-visible,summary:focus-visible{
  outline-color:var(--pg-gold)!important;
}

/* Accueil et composants partagés */
.catalog .hero-meta span,.catalog .tag,.catalog-controls,.home-dashboard{
  border-color:var(--pg-border);color:var(--pg-muted);background:rgb(18 26 44 / 88%);box-shadow:none;
}
.catalog .game-card{
  border-color:var(--pg-border);color:var(--pg-text);background:var(--pg-surface);
  box-shadow:0 18px 44px rgb(0 0 0 / 28%);
}
.catalog .game-card:hover,.catalog .game-card:focus-visible{box-shadow:0 24px 58px rgb(0 0 0 / 42%)}
.catalog .card-art{border-color:var(--pg-border)}
.catalog .card-copy p,.catalog footer,.catalog .hero>p{color:var(--pg-muted)}
.catalog .game-card .play-link,.install-banner button,.tournament-link{
  border-color:var(--pg-gold);color:#201807;background:var(--pg-gold);
}
.catalog footer{border-color:var(--pg-border)}
.catalog-controls input,.catalog-controls button,.home-dashboard button,.home-dashboard>div{
  border-color:var(--pg-border);color:var(--pg-text);background:var(--pg-surface-2);
}
.catalog-controls button.active{border-color:var(--pg-accent);color:var(--pg-accent-ink);background:var(--pg-accent)}
.home-dashboard small,.catalog-controls p{color:var(--pg-muted)}
.daily-card{
  border-color:var(--pg-border);color:var(--pg-text);
  background:linear-gradient(120deg,#1b2740,#243452);box-shadow:0 16px 38px rgb(0 0 0 / 24%);
}
.wallet b{border-color:var(--pg-border);background:var(--pg-surface)}
.pg-loader,.pg-leaving::after{color:#201807;background:var(--pg-gold)}
.pg-loader-logo span,.home-avatar,.pg-big-avatar{background:var(--pg-accent)}

/* Panneaux et commandes des jeux */
.menu-panel,.settings,.race-settings,.panel,.score,.round,.touch-player,.race-touch-player{
  border-color:var(--pg-border)!important;background:rgb(18 26 44 / 90%)!important;
}
.settings select,.race-settings select,.toolbar select,.toolbar input[type="range"],.field select,.players input{
  border-color:var(--pg-border)!important;color:var(--pg-text)!important;background:var(--pg-surface-2)!important;
}
.actions button,.race-actions button,.secondary-button,.round button,.reset{
  border-color:var(--pg-border);color:var(--pg-text);background:var(--pg-surface-2);
}
.actions .primary,.race-actions .primary,.primary-button,.round a{
  border-color:var(--pg-gold);color:#201807;background:var(--pg-gold);
}
.home-link,.pong-link,.race-header a,.tournament header>a{color:var(--pg-accent)}
.game-shell,.arena-frame,.race-stage{
  border-color:var(--pg-border)!important;box-shadow:0 24px 62px rgb(0 0 0 / 38%);
}
.eyebrow,.race-header .eyebrow,.tournament header p{color:var(--pg-gold)}
.turn-badge{color:var(--pg-accent-ink);background:var(--pg-accent)}
.site-notice[data-type="success"]{border-color:var(--pg-accent);background:#123a30}
.site-notice[data-type="error"]{border-color:var(--pg-danger);background:#4a1d2b}

/* Le mode clair conserve la même hiérarchie colorée. */
body[data-pg-appearance="light"] .catalog .game-card,
body[data-pg-appearance="light"] .catalog-controls,
body[data-pg-appearance="light"] .home-dashboard{
  color:#161b27;background:#fff;
}
body[data-pg-appearance="light"] .catalog .tag,
body[data-pg-appearance="light"] .catalog .hero-meta span,
body[data-pg-appearance="light"] .catalog-controls input,
body[data-pg-appearance="light"] .catalog-controls button,
body[data-pg-appearance="light"] .home-dashboard button,
body[data-pg-appearance="light"] .home-dashboard>div{color:#161b27;background:#f7f9fc}
